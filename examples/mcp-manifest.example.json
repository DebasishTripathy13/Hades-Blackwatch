          "project_key": {
            "type": "string",
            "description": "Allowlisted SonarQube project key."
          }
        },
        "required": ["project_key"]
      }
    },
    {
      "name": "run_shell_command",
      "description": "Execute a local shell command.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          }
        },
        "required": ["command"]
      }
    }
  ]
}
